{
  "manifest_version": 3,
  "name": "清英在线 · 虚拟麦克风 (VMIC)",
  "version": "1.2.4",
  "description": "让清英在线站点只能拿到本插件注入的本地音频。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "assets/icon.png",
    "32": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "background": {
    "service_worker": "background/background.js"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VMIC - 虚拟麦克风",
    "default_icon": {
      "16": "assets/icon.png",
      "32": "assets/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.tsinghuaelt.com/*", "https://*.izhixue.cn/*"],
      "js": ["content/content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.tsinghuaelt.com/*", "https://*.izhixue.cn/*"],
      "js": ["content/content-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*.tsinghuaelt.com/*", "https://*.izhixue.cn/*"],
      "js": ["content/content-capture-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.tsinghuaelt.com/*", "https://*.izhixue.cn/*"],
      "js": ["content/content-capture.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
